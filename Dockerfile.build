ARG VERSION=
FROM golang:latest AS deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-dev libwebkit2gtk-4.1-dev nodejs npm \
    && rm -rf /var/lib/apt/lists/*

FROM deps AS build
RUN go install github.com/wailsapp/wails/v2/cmd/wails@v2.12.0

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci --prefix frontend

COPY . .

RUN if [ -n "$VERSION" ]; then \
        sed -i "s/\"productVersion\": \".*\"/\"productVersion\": \"$VERSION\"/" wails.json; \
    else \
        V=$(grep '^const AppVersion' src/version.go | sed 's/.*"\(.*\)".*/\1/') && \
        sed -i "s/\"productVersion\": \".*\"/\"productVersion\": \"$V\"/" wails.json; \
    fi

RUN wails build -tags webkit2_41
